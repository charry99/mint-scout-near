# Copy to .env and fill in. Never commit .env.
# Otari hosted gateway token (starts with otk_). Get one at https://otari.ai
# The app works without it — /api/explain then returns a graceful fallback.
OTARI_AI_TOKEN=
# Optional: override the Otari model used for explanations.
# OTARI_MODEL=deepseek/deepseek-v4-pro-0813
# Optional: server port (default 3001).
# PORT=3001
